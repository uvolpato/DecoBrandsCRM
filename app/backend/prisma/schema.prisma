// Schema del database decobrands_db (spec §4.2, D-29, D-33).
// Nomi di tabelle e colonne uguali alla spec: chi legge la spec trova lo stesso nome qui.
// Vincoli che Prisma non esprime (CHECK, EXCLUDE, indice univoco parziale, colonna generata)
// stanno nelle migrazioni SQL: iniziale e schema_completo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Anagrafiche (§4.2.1–§4.2.6) ----------

/// Identità del fornitore (D-46, §4.6): l'id non cambia mai. Qui stanno le regole del CRM e i campi
/// tecnici; i dati descrittivi da Integra stanno in fornitori_versioni, il codice in codici_esterni.
model fornitori {
  id                     BigInt    @id @default(autoincrement())
  versione_corrente_id   BigInt? // versione in vigore; sempre una versione di questo fornitore (FK composta)
  soggetto_id            BigInt?   @unique // anagrafica unica a soggetti (D-102)
  giorni_attesa_conferma Int       @default(30)
  giorno_bollettino      Int       @default(10) @db.SmallInt // CHECK 1–28 (§5.6, D-03)
  tipo_provvigione       String    @default("fatturato") @db.VarChar(20) // maturato | fatturato (§5.5)
  giorni_incasso         Int       @default(60) @db.SmallInt // §5.14
  // D-183 §19: le spese in fattura (trasporto, imballo) entrano nella base della provvigione? no = escluse
  spese_base_provvigione Boolean   @default(false)
  note                   String?
  attivo                 Boolean   @default(true)
  creato_il              DateTime  @default(now()) @db.Timestamptz(6)
  modificato_il          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  sincronizzato_il       DateTime? @db.Timestamptz(6)

  corrente  fornitori_versioni?     @relation("corrente", fields: [id, versione_corrente_id], references: [fornitore_id, id], onDelete: Restrict, map: "fornitori_versione_corrente_fkey")
  soggetto  soggetti?               @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  versioni  fornitori_versioni[]    @relation("versioni")
  scaglioni provvigioni_scaglioni[]
  eccezioni provvigioni_eccezioni[]
  agenzie   interscambio[]
}

/// Dati descrittivi del fornitore da Integra: si aggiungono soltanto (trigger), mai UPDATE né DELETE (D-46).
model fornitori_versioni {
  id              BigInt   @id @default(autoincrement())
  fornitore_id    BigInt
  valido_dal      DateTime @default(now()) @db.Timestamptz(6)
  fonte           String   @db.VarChar(10) // integra | crm (CHECK)
  creato_da       BigInt?
  piva            String?  @db.VarChar(20) // non univoca: ogni cambio è una versione nuova
  ragione_sociale String   @db.VarChar(255)
  paese           String?  @db.VarChar(100)

  fornitore  fornitori                  @relation("versioni", fields: [fornitore_id], references: [id], onDelete: Restrict)
  autore     utenti?                    @relation(fields: [creato_da], references: [id], onDelete: Restrict)
  correnti   fornitori[]                @relation("corrente")
  pratiche   ordini_fornitore_testata[]
  bollettini bollettini_testata[]
  documenti  documenti_in_arrivo[]

  @@unique([fornitore_id, id])
  @@index([piva])
  @@index([ragione_sociale(ops: raw("gin_trgm_ops"))], type: Gin) // ricerca delle Pratiche (A7-24)
}

/// Identità del cliente, scritta solo dalla sincronizzazione (§4.2.20, D-33, D-46). Dati descrittivi
/// in clienti_versioni; P.IVA doppie ammesse (D-35).
model clienti {
  id                   BigInt    @id @default(autoincrement())
  versione_corrente_id BigInt? // versione in vigore; sempre una versione di questo cliente (FK composta)
  soggetto_id          BigInt?   @unique // anagrafica unica a soggetti (D-102)
  attivo               Boolean   @default(true)
  modificato_il        DateTime? @db.Timestamptz(6) // data di modifica in Integra
  sincronizzato_il     DateTime? @db.Timestamptz(6)

  corrente clienti_versioni?  @relation("corrente", fields: [id, versione_corrente_id], references: [cliente_id, id], onDelete: Restrict, map: "clienti_versione_corrente_fkey")
  soggetto soggetti?          @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  versioni clienti_versioni[] @relation("versioni")
  agenzie  interscambio[]
}

/// Dati descrittivi del cliente da Integra: si aggiungono soltanto (trigger) (D-46).
model clienti_versioni {
  id              BigInt   @id @default(autoincrement())
  cliente_id      BigInt
  valido_dal      DateTime @default(now()) @db.Timestamptz(6)
  fonte           String   @db.VarChar(10) // integra | crm (CHECK)
  creato_da       BigInt?
  piva            String?  @db.VarChar(20) // non univoca: Integra può avere P.IVA doppie (D-35)
  ragione_sociale String   @db.VarChar(255)
  indirizzo       String?  @db.VarChar(255)
  cap             String?  @db.VarChar(10)
  citta           String?  @db.VarChar(100)
  provincia       String?  @db.VarChar(5)
  email           String?  @db.VarChar(200)

  cliente  clienti                    @relation("versioni", fields: [cliente_id], references: [id], onDelete: Restrict)
  autore   utenti?                    @relation(fields: [creato_da], references: [id], onDelete: Restrict)
  correnti clienti[]                  @relation("corrente")
  pratiche ordini_fornitore_testata[]
  righe    bollettini_righe[]

  @@unique([cliente_id, id])
  @@index([piva])
  @@index([ragione_sociale(ops: raw("gin_trgm_ops"))], type: Gin) // ricerca delle Pratiche (A7-24)
}

/// D-164: nomi letti che l'operatore ha già abbinato a mano a un fornitore o a un cliente. Il documento
/// successivo con lo stesso nome letto (normalizzato) si riconosce subito. `ruolo_id` è clienti.id o
/// fornitori.id secondo il tipo: niente FK, come codici_esterni.
model alias_letti {
  id                BigInt   @id @default(autoincrement())
  tipo              String   @db.VarChar(12) // fornitore | cliente (CHECK)
  nome_normalizzato String   @db.VarChar(255)
  nome_letto        String   @db.VarChar(255) // com'era scritto sul documento, per la scheda
  ruolo_id          BigInt
  creato_da         BigInt?
  creato_il         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([tipo, nome_normalizzato])
}

/// Codice di un'entità in un sistema esterno (Integra, …). Due codici possono puntare alla stessa
/// entità (fusione o cambio di codice). entita_id punta a clienti o fornitori secondo il tipo: niente FK.
model codici_esterni {
  id        BigInt   @id @default(autoincrement())
  sistema   String   @db.VarChar(20) // integra | vecchio_crm (CHECK)
  tipo      String   @db.VarChar(20) // cliente | fornitore | subagente | soggetto | sede | interscambio (CHECK)
  codice    String   @db.VarChar(50)
  etichetta String?  @db.VarChar(50) // codice leggibile dell'anagrafica, accanto a quello del ruolo (§5.4)
  entita_id BigInt
  creato_il DateTime @default(now()) @db.Timestamptz(6)

  @@unique([sistema, tipo, codice])
  @@index([tipo, entita_id])
}

/// Percentuali per scaglione di sconto, in versioni datate (§5.11, D-25).
model provvigioni_scaglioni {
  id            BigInt   @id @default(autoincrement())
  fornitore_id  BigInt
  sconto_min    Decimal  @default(0) @db.Decimal(5, 2)
  pct_agente    Decimal  @default(0) @db.Decimal(5, 2)
  pct_subagente Decimal  @default(0) @db.Decimal(5, 2)
  valido_dal    DateTime @db.Date
  creato_il     DateTime @default(now()) @db.Timestamptz(6)

  fornitore fornitori @relation(fields: [fornitore_id], references: [id], onDelete: Cascade)

  @@unique([fornitore_id, sconto_min, valido_dal])
}

/// Eccezioni personali del subagente per fornitore × sconto, con un periodo (§4.2.3, D-51): non legate
/// alle versioni delle percentuali. Periodi [dal, al) senza sovrapposizioni: EXCLUDE nella migrazione eccezioni_periodo.
model provvigioni_eccezioni {
  id            BigInt    @id @default(autoincrement())
  fornitore_id  BigInt
  subagente_id  BigInt
  sconto_min    Decimal   @db.Decimal(5, 2) // la soglia dello scaglione a cui si applica
  pct_personale Decimal   @db.Decimal(5, 2)
  valido_dal    DateTime  @db.Date
  valido_al     DateTime? @db.Date // escluso, come interscambio; NULL = senza fine
  creato_il     DateTime  @default(now()) @db.Timestamptz(6)

  fornitore fornitori @relation(fields: [fornitore_id], references: [id], onDelete: Restrict)
  subagente subagenti @relation(fields: [subagente_id], references: [id])

  @@index([subagente_id])
}

model agenti {
  id          BigInt   @id @default(autoincrement())
  codice      String   @unique @db.VarChar(50)
  nome        String   @db.VarChar(100)
  cognome     String   @db.VarChar(100)
  email       String?  @db.VarChar(255)
  telefono    String?  @db.VarChar(50)
  attivo      Boolean  @default(true)
  soggetto_id BigInt?  @unique // anagrafica unica a soggetti (D-102)
  creato_il   DateTime @default(now()) @db.Timestamptz(6)

  soggetto  soggetti?               @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  subagenti subagenti[]
  pratiche  ordini_fornitore_testata[]
}

model subagenti {
  id          BigInt  @id @default(autoincrement())
  agente_id   BigInt
  codice      String  @unique @db.VarChar(50)
  nome        String  @db.VarChar(100)
  cognome     String  @db.VarChar(100)
  email       String? @db.VarChar(255)
  attivo      Boolean @default(true)
  soggetto_id BigInt? @unique // anagrafica unica a soggetti (D-102)

  agente    agenti                  @relation(fields: [agente_id], references: [id], onDelete: Cascade)
  soggetto  soggetti?               @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  eccezioni provvigioni_eccezioni[]
  agenzie   interscambio[]
}

/// Subagente × cliente × fornitore: chi segue il cliente e con che sconto (§4.2.6, D-27).
model interscambio {
  id                       BigInt    @id @default(autoincrement())
  subagente_id             BigInt
  cliente_id               BigInt
  fornitore_id             BigInt
  codice_cliente_fornitore String?   @db.VarChar(50)
  sconto                   Decimal   @default(0) @db.Decimal(5, 2)
  pct_subagente            Decimal?  @db.Decimal(5, 2)
  regola_mensile           String?   @db.VarChar(10) // prima | piu_alta
  valido_dal               DateTime  @db.Date // il documento va al subagente valido alla sua data (D-35)
  valido_al                DateTime? @db.Date // escluso; NULL = segue il cliente oggi
  da_confermare            Boolean   @default(false) // dal vecchio CRM, da confermare al primo uso (D-159)
  creato_il                DateTime  @default(now()) @db.Timestamptz(6)

  subagente subagenti @relation(fields: [subagente_id], references: [id], onDelete: Restrict)
  cliente   clienti   @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  fornitore fornitori @relation(fields: [fornitore_id], references: [id], onDelete: Restrict)
  sconti    sconti[]

  // periodi senza sovrapposizioni per cliente e per codice: EXCLUDE nella migrazione iniziale (D-35 §19): vale anche per il codice, quindi niente UNIQUE semplice
  @@index([subagente_id])
  @@index([cliente_id])
  @@index([fornitore_id, codice_cliente_fornitore])
}

// ---------- Pratiche (§4.2.7–§4.2.8) ----------

model ordini_fornitore_testata {
  id                    BigInt    @id @default(autoincrement())
  fornitore_id          BigInt
  fornitore_versione_id BigInt
  ordine_cliente_id     BigInt? // senza FK fino alla vendita diretta (§17, D-33)
  numero_ordine         String    @db.VarChar(50)
  data_ordine           DateTime  @db.Date
  cliente_id            BigInt
  cliente_versione_id   BigInt
  agente_id             BigInt?
  importo_merce         Decimal?  @db.Decimal(12, 2)
  stato                 String    @default("inviato") @db.VarChar(20) // inviato | confermato | fatturato: dal motore (D-52)
  // numero_ordine = numero della pratica, data_ordine = data del primo ordine (D-60); ordini e conferme sono documenti
  // numero_ordine_fornitore = numero d'ordine del fornitore (D-169); unico per fornitore (indice parziale nella migrazione)
  numero_ordine_fornitore String? @db.VarChar(50)
  note                  String?
  // risultato del motore, scritto da aggiornaPratica nella stessa transazione di ogni modifica (D-52 §19)
  importo               Decimal   @default(0) @db.Decimal(14, 2) // importoPratica
  variazioni            Boolean   @default(false) // haVariazioni
  variazione            Decimal   @default(0) @db.Decimal(14, 2) // scostamento delle righe che variano
  creato_il             DateTime  @default(now()) @db.Timestamptz(6)
  modificato_il         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  fornitore fornitori_versioni           @relation(fields: [fornitore_id, fornitore_versione_id], references: [fornitore_id, id], onDelete: Restrict, map: "ordini_fornitore_testata_fornitore_versione_fkey")
  cliente   clienti_versioni             @relation(fields: [cliente_id, cliente_versione_id], references: [cliente_id, id], onDelete: Restrict, map: "ordini_fornitore_testata_cliente_versione_fkey")
  agente    agenti?                      @relation(fields: [agente_id], references: [id])
  righe     ordini_fornitore_righe[]
  documenti ordini_fornitore_documenti[]
  arrivati  documenti_in_arrivo[]

  @@index([fornitore_id, stato])
  @@index([cliente_id])
  @@index([data_ordine])
  @@index([importo])
  @@index([agente_id])
  @@unique([numero_ordine]) // OF/AAAA/NNN non si ripete nemmeno per errore di script (A3-10)
  @@index([numero_ordine(ops: raw("gin_trgm_ops"))], type: Gin) // ricerca delle Pratiche (A7-24)
}

/// Documenti della pratica (§4.2.7.1, D-60): ordine | conferma | proforma | fattura | nota_credito | pagamento | altro.
/// Solo fattura e nota di credito sono la base delle provvigioni (§5.3).
model ordini_fornitore_documenti {
  id              BigInt    @id @default(autoincrement())
  testata_id      BigInt
  tipo            String    @db.VarChar(20) // CHECK nella migrazione (D-60)
  numero          String    @db.VarChar(50) // vuoto per un pagamento senza numero
  data            DateTime  @db.Date
  importo         Decimal   @default(0) @db.Decimal(12, 2) // negativo per la nota di credito
  storno_totale   Boolean   @default(false)
  fattura_id      BigInt? // la fattura stornata dalla nota di credito
  stato_incasso   String    @default("da_incassare") @db.VarChar(15) // §5.14
  insoluta_dal    DateTime? @db.Date
  pagata_il       DateTime? @db.Date
  fonte_incasso   String?   @db.VarChar(20)
  nota_incasso    String? // segnalazione del fornitore (§5.14), separata dalle note del documento
  sollecitata_il  DateTime? @db.Date
  solleciti       Int       @default(0) @db.SmallInt
  arrivo_id       BigInt? // file nel documento in arrivo
  liquidazione_id BigInt? // trimestre in cui il subagente l\'ha incassata (D-11)
  // D-183 §19: valori calcolati salvati (base, spese escluse, sconto medio, scaglione, % e provvigioni)
  // e quando si sono fissati. Li calcola e salva solo il server (V12); congelato_il non nullo = chiuso,
  // non si ricalcolano né si toccano più (si corregge con documenti di rettifica).
  calcolo        Json?
  congelato_il   DateTime? @db.Timestamptz(6)
  note            String?
  // D-174 §19: più conferme/proforme per la stessa pratica. ruolo = come l'operatore l'ha abbinata
  // (parziale: si somma alle altre; sostituisce: revisione, quella vecchia resta superata e non conta).
  ruolo           String?   @db.VarChar(15)
  superato_da     BigInt? // id del documento che lo sostituisce (il sostituito non conta, D-174)
  creato_il       DateTime  @default(now()) @db.Timestamptz(6)

  fattura          ordini_fornitore_documenti?  @relation("storno", fields: [fattura_id], references: [id], onDelete: Restrict)
  note_credito     ordini_fornitore_documenti[] @relation("storno")
  arrivo           documenti_in_arrivo?         @relation(fields: [arrivo_id], references: [id], onDelete: SetNull)
  liquidazione     liquidazioni?                @relation(fields: [liquidazione_id], references: [id], onDelete: Restrict)
  righe_bollettino bollettini_righe[]
  attese_bollettino bollettini_attese[]
  testata          ordini_fornitore_testata     @relation(fields: [testata_id], references: [id], onDelete: Cascade)
  correzione       provvigioni_correzioni?
  righe            ordini_fornitore_righe[]

  @@index([numero, tipo])
  @@index([numero(ops: raw("gin_trgm_ops"))], type: Gin) // ricerca delle Pratiche (A7-24)
  @@index([testata_id])
  @@index([fattura_id])
  @@index([liquidazione_id])
  @@index([arrivo_id])
}

/// Correzione della quota del subagente su un documento (§4.2.7.2, D-27).
model provvigioni_correzioni {
  id           BigInt   @id @default(autoincrement())
  documento_id BigInt   @unique
  tipo         String   @db.VarChar(10) // pct | nessuna | importo
  valore       Decimal  @default(0) @db.Decimal(12, 2)
  motivo       String
  creato_da    BigInt?
  creato_il    DateTime @default(now()) @db.Timestamptz(6)

  documento ordini_fornitore_documenti @relation(fields: [documento_id], references: [id], onDelete: Cascade)
  autore    utenti?                    @relation(fields: [creato_da], references: [id], onDelete: Restrict)
}

/// Righe per fase: tre fotografie che non si sovrascrivono (§4.2.8, §5.8); ogni riga sta sul suo documento (D-60).
model ordini_fornitore_righe {
  id              BigInt   @id @default(autoincrement())
  testata_id      BigInt
  documento_id    BigInt? // null solo per le righe di fattura di prima di D-60 con più fatture nella pratica
  fase            String   @default("ordine") @db.VarChar(20) // ordine | conferma | fattura
  numero_riga     Int
  codice          String?  @db.VarChar(100)
  descrizione     String?  @db.VarChar(255)
  um              String?  @db.VarChar(20)
  quantita        Decimal? @db.Decimal(12, 3)
  prezzo_unitario Decimal? @db.Decimal(12, 4)
  importo         Decimal? @db.Decimal(12, 2)
  // D-183 §19: riga di spesa (trasporto, imballo, «Fracht»): non è merce, esce da lordo e netto dello
  // sconto medio e (di norma) dalla base della provvigione. Si segna nella correzione del documento.
  spesa           Boolean  @default(false)

  testata   ordini_fornitore_testata    @relation(fields: [testata_id], references: [id], onDelete: Cascade)
  documento ordini_fornitore_documenti? @relation(fields: [documento_id], references: [id], onDelete: Cascade)

  @@unique([documento_id, numero_riga])
  @@index([testata_id])
}

// ---------- Bollettini (§4.2.9–§4.2.10) ----------

model bollettini_testata {
  id                    BigInt    @id @default(autoincrement())
  fornitore_id          BigInt
  fornitore_versione_id BigInt
  mese                  Int // CHECK 1–12
  anno                  Int
  stato                 String    @default("da_verificare") @db.VarChar(20) // da_verificare | verificato | contestato
  chiuso_il             DateTime? @db.Timestamptz(6) // verificato o contestato: decide il trimestre di storni e riaccrediti (D-11)
  chiuso_da             BigInt?
  note                  String?
  creato_il             DateTime  @default(now()) @db.Timestamptz(6)
  modificato_il         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  chiusore  utenti?               @relation(fields: [chiuso_da], references: [id], onDelete: Restrict)
  fornitore fornitori_versioni    @relation(fields: [fornitore_id, fornitore_versione_id], references: [fornitore_id, id], onDelete: Restrict, map: "bollettini_testata_fornitore_versione_fkey")
  righe     bollettini_righe[]
  attese    bollettini_attese[]
  arrivati  documenti_in_arrivo[]

  @@unique([fornitore_id, mese, anno])
}

/// Righe del bollettino; pct_calcolata e importo_calcolato si congelano alla verifica (§5.11).
model bollettini_righe {
  id                   BigInt    @id @default(autoincrement())
  testata_id           BigInt
  fattura_numero       String    @db.VarChar(50)
  fattura_data         DateTime? @db.Date
  cliente_id           BigInt? // cliente e versione vanno insieme (CHECK)
  cliente_versione_id  BigInt?
  importo_merce        Decimal?  @db.Decimal(12, 2)
  pct_riconosciuta     Decimal?  @db.Decimal(5, 2)
  importo_riconosciuto Decimal   @db.Decimal(12, 2)
  pct_calcolata        Decimal?  @db.Decimal(5, 2)
  importo_calcolato    Decimal?  @db.Decimal(12, 2)
  differenza           Decimal?  @default(dbgenerated("(importo_riconosciuto - COALESCE(importo_calcolato, (0)::numeric))")) @db.Decimal(12, 2) // colonna generata
  tipo_riga            String    @default("provvigione") @db.VarChar(15) // provvigione | storno | riaccredito
  fattura_mese         DateTime? @db.Date
  documento_id         BigInt? // documento abbinato dalla riconciliazione (§5.11)
  liquidazione_id      BigInt? // storno o riaccredito: trimestre in cui è andato al subagente (D-11)
  decisione            String?   @db.VarChar(12) // riga che non quadra: accettato | contestato | attendere (§7.7, D-49); CHECK nella migrazione
  decisione_motivo     String? // obbligatorio per contestato: va nel testo della contestazione
  deciso_da            BigInt?
  deciso_il            DateTime? @db.Timestamptz(6)
  creato_il            DateTime  @default(now()) @db.Timestamptz(6)

  decisore     utenti?                     @relation(fields: [deciso_da], references: [id], onDelete: Restrict)
  testata      bollettini_testata          @relation(fields: [testata_id], references: [id], onDelete: Cascade)
  documento    ordini_fornitore_documenti? @relation(fields: [documento_id], references: [id], onDelete: SetNull)
  liquidazione liquidazioni?               @relation(fields: [liquidazione_id], references: [id], onDelete: Restrict)
  cliente      clienti_versioni?           @relation(fields: [cliente_id, cliente_versione_id], references: [cliente_id, id], onDelete: Restrict, map: "bollettini_righe_cliente_versione_fkey")

  @@index([fattura_numero])
  @@index([cliente_id])
  @@index([testata_id])
  @@index([documento_id])
  @@index([liquidazione_id])
  @@index([deciso_da]) // FK SET/RESTRICT senza indice: l'eliminazione dell'utente scorrerebbe le righe (A3-11)
}

/// Decisione su un documento del mese che manca nel bollettino (§7.7, D-56): nostra, non è una riga del fornitore.
model bollettini_attese {
  id               BigInt   @id @default(autoincrement())
  testata_id       BigInt
  documento_id     BigInt
  decisione        String   @db.VarChar(12) // attendere | contestato (CHECK; motivo obbligatorio per contestato)
  decisione_motivo String?
  deciso_da        BigInt?
  deciso_il        DateTime @default(now()) @db.Timestamptz(6)

  testata   bollettini_testata         @relation(fields: [testata_id], references: [id], onDelete: Cascade)
  documento ordini_fornitore_documenti @relation(fields: [documento_id], references: [id], onDelete: Restrict)
  decisore  utenti?                    @relation(fields: [deciso_da], references: [id], onDelete: Restrict)

  @@unique([testata_id, documento_id])
  @@index([documento_id])
}

// ---------- Liquidazioni (§4.2.19, D-33) ----------

model liquidazioni {
  id        BigInt   @id @default(autoincrement())
  anno      Int      @db.SmallInt
  trimestre Int      @db.SmallInt // CHECK 1–4
  chiusa_il DateTime @default(now()) @db.Timestamptz(6)
  chiusa_da BigInt?
  totali    Json // fotografia del prospetto pagato

  documenti ordini_fornitore_documenti[]
  storni    bollettini_righe[]

  autore utenti? @relation(fields: [chiusa_da], references: [id], onDelete: Restrict)

  @@unique([anno, trimestre])
}

// ---------- Ingresso documenti (§4.2.12–§4.2.13) ----------

model documenti_in_arrivo {
  id                     BigInt    @id @default(autoincrement())
  origine                String    @db.VarChar(12) // email | caricamento
  email_da               String?
  email_oggetto          String?
  file_nome              String
  file_hash              String    @unique @db.Char(64) // il file sta su disco con questo nome (D-34)
  file_percorso          String    @db.VarChar(255) // sotto DOCUMENTI_DIR: in coda in_arrivo/AAAA/AAAAMMGG/<impronta>.<est>, abbinato pratiche/… (D-60)
  stato                  String    @default("in_coda") @db.VarChar(16)
  tentativi              Int       @default(0)
  errore                 String?
  tipo                   String?   @db.VarChar(16)
  fornitore_id           BigInt?
  fornitore_versione_id  BigInt? // fornitore e versione vanno insieme (CHECK)
  livello                String?   @db.VarChar(16) // dal campo meno affidabile in documenti_campi
  controlli              Json?
  lettura_grezza         Json? // D-170: risposta completa del lettore, per ricavare campi nuovi senza rileggere (mai al browser)
  modello                String?
  ricevuto_il            DateTime  @default(now()) @db.Timestamptz(6)
  letto_il               DateTime? @db.Timestamptz(6)
  controllato_il         DateTime? @db.Timestamptz(6)
  abbinato_pratica_id    BigInt?
  abbinato_bollettino_id BigInt?
  utente_id              BigInt? // chi ha caricato o controllato (D-33)
  scartato_il            DateTime? @db.Timestamptz(6)
  scartato_da            BigInt?
  motivo_scarto          String?   @db.VarChar(40)
  nota_scarto            String?

  fornitore  fornitori_versioni?          @relation(fields: [fornitore_id, fornitore_versione_id], references: [fornitore_id, id], onDelete: Restrict, map: "documenti_in_arrivo_fornitore_versione_fkey")
  pratica    ordini_fornitore_testata?    @relation(fields: [abbinato_pratica_id], references: [id])
  bollettino bollettini_testata?          @relation(fields: [abbinato_bollettino_id], references: [id])
  utente     utenti?                      @relation("documento_utente", fields: [utente_id], references: [id], onDelete: SetNull)
  scartatore utenti?                      @relation("documento_scartato", fields: [scartato_da], references: [id], onDelete: SetNull)
  campi      documenti_campi[]
  documenti  ordini_fornitore_documenti[]

  @@index([stato])
  @@index([fornitore_id])
  @@index([abbinato_pratica_id])
  @@index([abbinato_bollettino_id])
  @@index([utente_id]) // FK SET NULL senza indice (A3-11)
  @@index([scartato_da])
}

model documenti_campi {
  id            BigInt    @id @default(autoincrement())
  documento_id  BigInt
  campo         String
  valore_letto  String?
  valore_finale String?
  affidabilita  Decimal?  @db.Decimal(4, 3)
  posizione     Json? // §6.6
  precisione    String?   @db.VarChar(12) // esatta | approssimata | assente
  verificato    Boolean   @default(false)
  corretto_da   BigInt?
  corretto_il   DateTime? @db.Timestamptz(6)

  documento documenti_in_arrivo @relation(fields: [documento_id], references: [id], onDelete: Cascade)
  autore    utenti?             @relation(fields: [corretto_da], references: [id], onDelete: SetNull)

  @@index([documento_id])
  @@index([corretto_da]) // FK SET NULL sulla tabella più grande (A3-11)
}

// ---------- Gestione (§4.2.11, §4.2.14, §4.2.15, §4.2.18) ----------

/// Utenti propri del CRM: si entra con nome utente (o email) e password (D-29, D-39).
model utenti {
  id                     BigInt    @id @default(autoincrement())
  username               String    @unique @db.VarChar(50) // nome utente, sempre in minuscolo (D-39)
  email                  String    @unique @db.VarChar(200) // sempre in minuscolo
  nome                   String    @db.VarChar(120)
  ruolo                  String    @db.VarChar(15) // ruolo di Sistema: superutente | amministratore | utente (§8.3, D-45); un solo superutente
  password_hash          String?   @db.VarChar(200) // scrypt$N$r$p$sale$hash; NULL solo per l'utente dei servizi
  deve_cambiare_password Boolean   @default(true) // password provvisoria: va cambiata al primo accesso
  attivo                 Boolean   @default(true)
  sistema                Boolean   @default(false) // utente dei servizi automatici: non accede
  creato_il              DateTime  @default(now()) @db.Timestamptz(6)
  ultimo_accesso         DateTime? @db.Timestamptz(6)
  ultimo_invio           Json? // {quando, tipo: benvenuto | password | reset, errore}
  ingressi               Json?  @default("{}") // pagine di ingresso per area (D-87): {provvigioni?, dati?, gestione?}

  link               accessi_link[]
  aree               utenti_aree[]
  eventi             registro[]               @relation("registro_utente")
  visti              registro[]               @relation("registro_visto")
  correzioni         provvigioni_correzioni[]
  versioni_clienti   clienti_versioni[]
  versioni_fornitori fornitori_versioni[]
  liquidazioni       liquidazioni[]
  bollettini_chiusi  bollettini_testata[]
  righe_decise       bollettini_righe[]
  attese_decise      bollettini_attese[]
  documenti          documenti_in_arrivo[]    @relation("documento_utente")
  documenti_scartati documenti_in_arrivo[]    @relation("documento_scartato")
  campi_corretti     documenti_campi[]
  esecuzioni         servizi_esecuzioni[]
  impostazioni       impostazioni[]
  modifiche          modifiche[]
}

/// Livello di un utente in un'area (D-45): lettura < operatore < responsabile; nessuna riga = area chiusa.
model utenti_aree {
  utente_id BigInt
  area      String @db.VarChar(20) // dati | provvigioni | vendite (CHECK, D-47)
  livello   String @db.VarChar(15) // lettura | operatore | responsabile (CHECK)

  utente utenti @relation(fields: [utente_id], references: [id], onDelete: Cascade)

  @@id([utente_id, area])
}

/// Inviti e link monouso: si salva solo l'impronta SHA-256 del codice (§4.2.18).
model accessi_link {
  id        BigInt    @id @default(autoincrement())
  utente_id BigInt
  tipo      String    @db.VarChar(10) // reset (password dimenticata, D-39)
  impronta  String    @unique @db.Char(64)
  scade_il  DateTime  @db.Timestamptz(6)
  usato_il  DateTime? @db.Timestamptz(6)
  ip        String?   @db.VarChar(45)

  utente utenti @relation(fields: [utente_id], references: [id], onDelete: Cascade)

  @@index([utente_id])
}

/// Sessioni di connect-pg-simple (§3.3). utente_id è una colonna generata da sess
/// (vedi la migrazione): non si scrive mai, serve a chiudere le sessioni di un utente (D-33).
model sessioni {
  sid       String   @id @db.VarChar
  sess      Json
  expire    DateTime @db.Timestamptz(6)
  utente_id BigInt?  @default(dbgenerated("((sess ->> 'utente_id'::text))::bigint"))

  @@index([expire])
  @@index([utente_id])
}

/// Registro unico di eventi e anomalie (§4.2.11, §15, D-31). Lo scrive solo il server.
model registro {
  id            BigInt    @id @default(autoincrement())
  ts            DateTime  @default(now()) @db.Timestamptz(6)
  genere        String    @db.VarChar(10) // evento | anomalia
  livello       String    @default("info") @db.VarChar(10)
  codice        String    @db.VarChar(50)
  tipo          String?   @db.VarChar(30)
  azione        String?   @db.VarChar(30)
  servizio      String?   @db.VarChar(15)
  entita        String?   @db.VarChar(50)
  entita_id     BigInt?
  esito         String?   @db.VarChar(10)
  messaggio     String?   @db.VarChar(300)
  dettaglio     Json?
  utente_id     BigInt?
  operazione_id String?   @db.Uuid
  sessione_id   String?   @db.VarChar(100)
  ip            String?   @db.VarChar(45)
  // solo anomalie
  chiave        String?   @db.VarChar(120)
  volte         Int       @default(1)
  ultimo        DateTime? @db.Timestamptz(6)
  stato         String?   @db.VarChar(10) // aperta | chiusa
  visto_il      DateTime? @db.Timestamptz(6)
  visto_da      BigInt?
  chiusa_il     DateTime? @db.Timestamptz(6)

  utente utenti? @relation("registro_utente", fields: [utente_id], references: [id], onDelete: SetNull)
  vista  utenti? @relation("registro_visto", fields: [visto_da], references: [id], onDelete: SetNull)

  @@index([ts(sort: Desc)])
  @@index([genere, livello, ts])
  @@index([codice, ts])
  @@index([entita, entita_id])
  @@index([utente_id, ts])
  @@index([operazione_id])
  @@index([dettaglio(ops: JsonbPathOps)], type: Gin)
  @@index([visto_da])
}

/// Una riga per sezione; le password sono cifrate e non escono dalle API (§4.2.14).
model impostazioni {
  chiave        String   @id @db.VarChar(20)
  valore        Json
  aggiornato_il DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  aggiornato_da BigInt?

  autore utenti? @relation(fields: [aggiornato_da], references: [id], onDelete: SetNull)
}

/// Giri dei servizi automatici, per lo Stato del sistema (§4.2.15).
model servizi_esecuzioni {
  id         BigInt    @id @default(autoincrement())
  servizio   String    @db.VarChar(15)
  tipo       String    @db.VarChar(10) // lavoro | controllo
  inizio     DateTime  @default(now()) @db.Timestamptz(6)
  fine       DateTime? @db.Timestamptz(6)
  esito      String?   @db.VarChar(10)
  testo      String?   @db.VarChar(300)
  misure     Json?
  avviato_da BigInt?

  autore utenti? @relation(fields: [avviato_da], references: [id], onDelete: SetNull)

  @@index([servizio, inizio(sort: Desc)])
}

// ---------- Anagrafica unica a soggetti (D-100, D-101, D-102; specifica-anagrafica-soggetti.md §4) ----------
// Additiva: il master si aggiunge sopra clienti/fornitori/agenti/subagenti, che restano quelli che il
// codice Prisma scrive e legge. I ruoli si collegano con `soggetto_id` nullable; nessuna FK dello
// strato 0 cambia. Vincoli che Prisma non esprime (P.IVA corta, unicità parziali) stanno nella
// migrazione 20261108090000_anagrafica_soggetti.

/// Master dell'identità: solo chiavi di riconoscimento. I dati descrittivi restano nelle *_versioni.
model soggetti {
  id                       BigInt    @id @default(autoincrement())
  codice                   String    @unique @default(dbgenerated("('C'::text || lpad((nextval('soggetti_codice_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20) // D-102: codici da sequenza, mai riusati
  natura                   String    @db.VarChar(10) // azienda | persona (CHECK)
  paese                    String    @default("IT") @db.Char(2)
  piva                     String?   @db.VarChar(30) // come scritta in origine
  piva_norm                String    @default("") @db.VarChar(20) // maiuscolo, senza spazi né punti (§1.6)
  codice_fiscale           String?   @db.VarChar(30)
  cf_norm                  String    @default("") @db.VarChar(20)
  sorgente                 String    @default("crm") @db.VarChar(20) // integra | vecchio_crm | crm (CHECK)
  attivo                   Boolean   @default(true)
  note                     String?
  creato_il                DateTime  @default(now()) @db.Timestamptz(6)
  modificato_il            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  modificato_in_origine_il DateTime? @db.Timestamptz(6) // modificato_il della vista Integra (lettura incrementale)
  sincronizzato_il         DateTime? @db.Timestamptz(6)

  clienti      clienti[]
  fornitori    fornitori[]
  agenti       agenti[]
  subagenti    subagenti[]
  sedi         sedi[]
  recapiti     recapiti[]
  contatti     persone_contatti[]
  fatturazione fatturazione?

  // ricerca e controllo dei doppioni sul master (D-102); nomi della migrazione 20261108090000
  @@index([piva_norm], map: "soggetti_piva_norm_idx")
  @@index([cf_norm], map: "soggetti_cf_norm_idx")
}

/// Sede del soggetto: una catena = un soggetto con N punti vendita (§4.2). Il settore è della sede.
model sedi {
  id          BigInt    @id @default(autoincrement())
  soggetto_id BigInt
  tipo        String    @db.VarChar(20) // legale | operativa | punto_vendita | magazzino | fatturazione (CHECK)
  insegna     String?   @db.VarChar(255)
  indirizzo   String?   @db.VarChar(255)
  cap         String?   @db.VarChar(10)
  citta       String?   @db.VarChar(100)
  provincia   String?   @db.Char(2)
  paese       String    @default("IT") @db.Char(2)
  settore_id  BigInt?
  gruppo_id   BigInt?
  predefinita Boolean   @default(false) // una sola per tipo: indice parziale nella migrazione
  attivo      Boolean   @default(true)
  valido_dal  DateTime? @db.Date
  valido_al   DateTime? @db.Date // escluso, NULL = in vigore

  soggetto soggetti            @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  settore  settori?            @relation(fields: [settore_id], references: [id], onDelete: Restrict)
  gruppo   gruppi?             @relation(fields: [gruppo_id], references: [id], onDelete: Restrict)
  recapiti recapiti[]
  contatti persone_contatti[]

  @@index([soggetto_id])
  @@index([citta, provincia])
}

/// Recapito del soggetto, di una sua sede o di una persona (§4.3): uno solo dei tre collegamenti.
/// Non ha `attivo`: si chiude con `valido_al`.
model recapiti {
  id          BigInt    @id @default(autoincrement())
  soggetto_id BigInt?
  sede_id     BigInt?
  persona_id  BigInt?
  tipo        String    @db.VarChar(20) // email | pec | telefono | cellulare | fax | sito (CHECK)
  valore      String    @db.VarChar(255) // email in minuscolo; telefono in +39…
  etichetta   String?   @db.VarChar(30) // ordini | amministrazione | magazzino | direzione
  predefinito Boolean   @default(false)
  valido_dal  DateTime? @db.Date
  valido_al   DateTime? @db.Date

  soggetto soggetti? @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  sede     sedi?     @relation(fields: [sede_id], references: [id], onDelete: Restrict)
  persona  persone?  @relation(fields: [persona_id], references: [id], onDelete: Restrict)

  @@index([soggetto_id])
  @@index([sede_id])
}

/// Persona fisica (§4.4): può essere referente di più soggetti.
model persone {
  id      BigInt  @id @default(autoincrement())
  nome    String  @db.VarChar(100)
  cognome String  @db.VarChar(100)
  titolo  String? @db.VarChar(100)
  note    String?
  attivo  Boolean @default(true)

  contatti persone_contatti[]
  recapiti recapiti[]
}

/// Legame persona × soggetto (× sede facoltativa) con il suo periodo (§4.4).
model persone_contatti {
  id          BigInt    @id @default(autoincrement())
  persona_id  BigInt
  soggetto_id BigInt
  sede_id     BigInt?
  ruolo       String?   @db.VarChar(20) // titolare | acquisti | amministrazione | magazzino | referente (CHECK)
  referente   Boolean   @default(false)
  valido_dal  DateTime? @db.Date
  valido_al   DateTime? @db.Date

  persona  persone  @relation(fields: [persona_id], references: [id], onDelete: Restrict)
  soggetto soggetti @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
  sede     sedi?    @relation(fields: [sede_id], references: [id], onDelete: Restrict)

  @@index([persona_id, soggetto_id])
}

/// Fatturazione elettronica del soggetto fiscale, non del ruolo (§4.5). 1:1.
model fatturazione {
  soggetto_id            BigInt  @id
  codice_destinatario    String? @db.Char(7) // [A-Z0-9]{7}; 0000000 solo con identificativo estero (CHECK)
  pec_destinatario       String? @db.VarChar(255)
  codice_univoco_ufficio String? @db.Char(6) // solo Pubblica Amministrazione (IPA)
  id_paese_estero        String? @db.Char(2)
  id_codice_estero       String? @db.VarChar(28)
  regime_fiscale         String? @db.Char(4) // RF01…RF19
  split_payment          Boolean @default(false)
  reverse_charge         Boolean @default(false)
  esigibilita_iva        String? @db.Char(1) // I | D | S
  attiva                 Boolean @default(false)
  note                   String?

  soggetto soggetti @relation(fields: [soggetto_id], references: [id], onDelete: Restrict)
}

/// Sconti per legame cliente × fornitore (§4.6): dettagliano `interscambio.sconto`, che resta il canonico.
/// Solo tabella: nessuna API finché la regola dello sconto canonico è aperta (§8.2).
model sconti {
  id              BigInt    @id @default(autoincrement())
  interscambio_id BigInt
  ordine          Int       @db.SmallInt
  tipo            String    @db.VarChar(20) // commerciale | promozionale | speciale (CHECK)
  percentuale     Decimal   @db.Decimal(5, 2)
  valido_dal      DateTime? @db.Date
  valido_al       DateTime? @db.Date
  note            String?

  interscambio interscambio @relation(fields: [interscambio_id], references: [id], onDelete: Restrict) // D-139

  @@unique([interscambio_id, ordine, valido_dal])
}

/// Audit per campo (§4.7): chi ha cambiato la P.IVA di chi. Il registro (D-31) resta per gli eventi.
model modifiche {
  id           BigInt   @id @default(autoincrement())
  entita       String   @db.VarChar(40)
  entita_id    BigInt
  campo        String   @db.VarChar(60)
  valore_prima String?
  valore_dopo  String?
  utente_id    BigInt?
  quando       DateTime @default(now()) @db.Timestamptz(6)

  utente utenti? @relation(fields: [utente_id], references: [id], onDelete: SetNull)

  @@index([entita, entita_id])
}

/// Tabelle di riferimento appese alle sedi (§4.8).
model gruppi {
  id          BigInt  @id @default(autoincrement())
  codice      String  @unique @db.VarChar(50)
  descrizione String  @db.VarChar(255)
  attivo      Boolean @default(true)

  sedi sedi[]
}

model settori {
  id          BigInt  @id @default(autoincrement())
  codice      String  @unique @db.VarChar(50)
  descrizione String  @db.VarChar(255)
  attivo      Boolean @default(true)

  sedi sedi[]
}

// ---------- Storico dei legami del vecchio CRM (D-112, §4.7.2–4.7.3) ----------
// Solo lettura per l'app: propone subagente e sconto, non crea niente. Nessuna FK obbligatoria
// verso clienti/fornitori/subagenti: è la ragione per cui l'import massivo era fermo (D-112).
// I vincoli che Prisma non esprime (CHECK su fonte e stato) stanno nella migrazione 20261112090000.

/// Fotografia dei 4022 legami del vecchio CRM, con testi e id legacy per proporre senza anagrafica.
model interscambio_storico {
  id                        BigInt    @id @default(autoincrement())
  fonte                     String    @db.VarChar(20) // vecchio_crm (CHECK)
  estratto_il               DateTime  @db.Date
  cliente_legacy_id         BigInt
  fornitore_legacy_id       BigInt
  cliente_codice_fornitore  String?   @db.VarChar(50) // la chiave che portano i documenti
  cliente_ragione_sociale   String?   @db.VarChar(255)
  cliente_piva              String?   @db.VarChar(20)
  cliente_piva_norm         String    @default("") @db.VarChar(20) // per l'indice e il confronto
  cliente_cf                String?   @db.VarChar(30)
  fornitore_ragione_sociale String?   @db.VarChar(255)
  fornitore_piva            String?   @db.VarChar(20)
  agente_nome               String?   @db.VarChar(200)
  subagente_nome            String?   @db.VarChar(200) // NULL = fornitore senza rappresentanza (1625)
  sconto_1                  Decimal   @default(0) @db.Decimal(5, 2)
  sconto_2                  Decimal   @default(0) @db.Decimal(5, 2)
  cliente_id                BigInt? // si riempiono quando i ruoli nascono; nessuna FK obbligatoria
  fornitore_id              BigInt?
  subagente_id              BigInt?
  interscambio_id           BigInt?
  stato                     String    @default("da_usare") @db.VarChar(12) // da_usare | usata | scartata (CHECK)
  nota                      String?
  creato_il                 DateTime  @default(now()) @db.Timestamptz(6)
  usato_il                  DateTime? @db.Timestamptz(6)

  // i nomi sono quelli nel database (migrazione 20261112090000): una rinomina non serve
  @@unique([fonte, cliente_legacy_id, fornitore_legacy_id], map: "interscambio_storico_fonte_cliente_fornitore_key")
  @@index([fornitore_piva, cliente_codice_fornitore], map: "interscambio_storico_fornitore_piva_codice_idx")
  @@index([cliente_codice_fornitore], map: "interscambio_storico_cliente_codice_idx")
  @@index([stato], map: "interscambio_storico_stato_idx")
  @@index([cliente_piva_norm])
  @@index([subagente_nome])
}

/// Le 3403 schede del vecchio CRM: i campi per riconoscere e creare, senza ruoli né deduplica.
model soggetti_storico {
  id             BigInt    @id @default(autoincrement())
  legacy_id      BigInt    @unique
  ragione_sociale String?  @db.VarChar(255)
  nome           String?   @db.VarChar(100)
  cognome        String?   @db.VarChar(100)
  piva           String?   @db.VarChar(20)
  piva_norm      String    @default("") @db.VarChar(20)
  codice_fiscale String?   @db.VarChar(30)
  cf_norm        String    @default("") @db.VarChar(20)
  indirizzo      String?   @db.VarChar(255)
  cap            String?   @db.VarChar(10)
  citta          String?   @db.VarChar(100)
  provincia      String?   @db.Char(2)
  paese          String?   @db.Char(2)
  email          String?   @db.VarChar(200)
  telefono       String?   @db.VarChar(50)
  sorgente       String    @db.VarChar(20) // vecchio_crm (CHECK)
  creato_il      DateTime  @default(now()) @db.Timestamptz(6)
}
