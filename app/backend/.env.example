DATABASE_URL=postgresql://decobrands:PASSWORD@localhost:5432/decobrands_db?schema=public
PORT=8002
# Ambiente (obbligatorio): development (sviluppo), test (prove) o production (esercizio).
# Senza, il backend non parte. In esercizio: NODE_ENV=production
NODE_ENV=development
# Firma del cookie di sessione: stringa casuale lunga, diversa per ogni installazione
SESSION_SECRET=CAMBIARE
# Chiave per cifrare i segreti delle Impostazioni (password di casella, posta, Integra). Genera con `openssl rand -base64 48`.
SEGRETI_CHIAVE=CAMBIARE
# Indirizzo pubblico dell'app, per i link nelle email (password dimenticata)
APP_URL=http://localhost:8001
# Ponte di sola lettura verso le viste di Integra (schema crm_viste). Senza, la sincronizzazione non parte.
PONTE_URL=postgresql://crm_lettura:PASSWORD@localhost:5432/decobrands_ponte_prova
# Limite ai tentativi su accesso e password (D-41): per persona, per IP (tutto l'ufficio), finestra in minuti
TENTATIVI=10
TENTATIVI_IP=100
TENTATIVI_MINUTI=15
# Caricamenti dei documenti (POST /api/documenti/carica): tetto per utente ogni 15 minuti
TENTATIVI_CARICAMENTI=100
# Documenti arrivati (caricamento, email): cartella dei file, con l'impronta SHA-256 come nome (D-34); limite in MB
DOCUMENTI_DIR=/srv/decobrands/documenti
DOCUMENTI_MAX_MB=20
# LibreOffice per il PDF (converte il medesimo Excel). Vuoto: soffice.com su Windows, soffice su Linux.
# SOFFICE=C:\Program Files\LibreOffice\program\soffice.com
