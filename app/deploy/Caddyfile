# Caddy davanti all'app (F7-A2, spec 3.2 e 3.4): tutto al frontend Next, che inoltra /api al backend.
# Caddy >= 2.5. Backend e frontend ascoltano solo su 127.0.0.1 (8002 e 8001).
#
# Due modi, uno attivo alla volta:
#  1. INTRANET (attivo qui sotto): porta 8082 in chiaro, si apre con l'indirizzo del server
#     (es. http://192.168.1.50:8082) o con un nome che risolve sul server (es. http://crm.decobrands.local).
#     In questo caso in backend/.env metti APP_URL con lo stesso indirizzo: il cookie di sessione
#     resta non "secure" (in HTTPS non verrebbe mai inviato). Niente HSTS in chiaro.
#  2. PUBBLICO (commentato): crm.decobrands.it con certificato. Si attiva al rilascio con il tecnico
#     della rete, scegliendo `tls internal` (certificato interno da installare sui PC) oppure la
#     sfida DNS (serve il modulo DNS del fornitore del dominio). Allora APP_URL diventa https://...
# Niente trusted_proxies: Caddy sostituisce X-Forwarded-For con l'IP del client, cosi' il limite ai
# tentativi per IP e il registro vedono l'IP vero (D-41).

:8082 {
	encode zstd gzip
	# 20/11/2026, come nel portale Luis (D-215): durante un aggiornamento i due processi stanno fermi
	# qualche minuto (npm ci + build) e chi apre l'app vedeva un errore di connessione. deploy.cmd
	# scrive deploy\manutenzione\maintenance.flag prima di fermare i servizi e lo toglie quando la
	# prova di salute e' passata: finche' c'e', Caddy risponde con la pagina di attesa che sta nella
	# stessa cartella. Se un deploy muore a meta' il cartello resta, e la pagina dice la verita'
	# (si toglie a mano: del C:\Decobrands\app\deploy\manutenzione\maintenance.flag).
	# Si riscrive sulla pagina chiesta, non si sposta: l'indirizzo resta quello (/pratiche resta
	# /pratiche) e il controllo della pagina sa dove tornare appena l'app risponde.
	@manutenzione file C:/Decobrands/app/deploy/manutenzione/maintenance.flag
	header @manutenzione Cache-Control "no-store" # mai in cache: alla fine del deploy deve sparire subito
	handle @manutenzione {
		root * C:/Decobrands/app/deploy/manutenzione
		try_files {path} /index.html
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8001 {
			# il PDF passa da LibreOffice e puo' impiegare ~1 minuto: non chiudere prima (F4-A3, 11)
			transport http {
				read_timeout 190s
			}
		}
	}
}

